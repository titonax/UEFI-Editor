{
  "name": "uefi-editor-qwen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "UEFI/BIOS Setup Editor with modular architecture following clean code principles",
  "author": "QWen Refactored Team",
  "license": "MIT",
  "keywords": [
    "uefi",
    "bios",
    "setup",
    "editor",
    "ami",
    "aptio"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepare": "husky install"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@mantine/core": "^7.17.2",
    "@mantine/hooks": "^7.17.2",
    "@mantine/notifications": "^7.17.2",
    "@tabler/icons-react": "^3.0.0",
    "file-saver": "^2.0.5",
    "immer": "^10.0.3",
    "react": "^19",
    "react-dom": "^19",
    "use-immer": "^0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/file-saver": "^2.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.3",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-dom": "^1.40.1",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-react-x": "^1.40.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.33",
    "postcss-preset-mantine": "^1.12.3",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6",
    "vite-plugin-checker": "^0.9",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
